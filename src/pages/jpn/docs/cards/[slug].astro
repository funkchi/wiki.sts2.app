---
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CardHero from '../../../../components/CardHero.astro';
import { cards, cardBySlug } from '../../../../data/cards';

export const getStaticPaths = (() => {
  return cards.map((card) => ({
    params: { slug: card.slug },
    props: { card },
  }));
}) satisfies GetStaticPaths;

const { card } = Astro.props;
const ja = card.translations?.ja;
const title = ja?.name || card.name;
const relatedCards = card.related
  .map((slug) => cardBySlug.get(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
const description = ja?.description || card.description || `${title} - Slay the Spire 2 カード。`;
---

<StarlightPage lang="ja" frontmatter={{ title, description }}>
  <CardHero card={card} locale="jpn">
    <Fragment slot="aside">
      {ja?.keywords && ja.keywords.length > 0 && (
        <>
          <h2 id="keywords">キーワード</h2>
          <p lang="ja">{ja.keywords.map((k) => <code class="game-keyword">{k}</code>)}</p>
        </>
      )}

      <h2 id="related">関連カード</h2>
      {relatedCards.length > 0 ? (
        <ul class="entity-links">
          {relatedCards.map((c) => (
            <li><a href={`/jpn/docs/cards/${c.slug}/`}>{c.translations?.ja?.name || c.name}</a></li>
          ))}
        </ul>
      ) : (
        <p>関連カードはありません。</p>
      )}
    </Fragment>
  </CardHero>

  <a class="return-link" href="/jpn/docs/cards/">カード一覧に戻る</a>
</StarlightPage>
