---
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { relics, relicBySlug } from '../../../../data/relics';
import { poolColor } from '../../../../data/characters';
import { renderEntityTextHtml } from '../../../../data/textHtml';

export const getStaticPaths = (() =>
  relics.map((relic) => ({ params: { slug: relic.slug }, props: { relic } }))) satisfies GetStaticPaths;

const { relic } = Astro.props;
const ja = relic.translations?.ja;
const related = relic.related
  .map((s) => relicBySlug.get(s))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const title = ja?.name || relic.name;
const description = ja?.description || relic.description || `${title} - Slay the Spire 2 レリック。`;
const displayDescription = ja?.description || relic.description;
const descriptionHtml = displayDescription
  ? renderEntityTextHtml(displayDescription, { locale: 'jpn' })
  : '説明はまだありません。';
const notesHtml = (ja?.notes || relic.notes).map((note) => renderEntityTextHtml(note, { locale: 'jpn' }));
---

<StarlightPage frontmatter={{ title, description }}>
  <div class="wiki-entity-hero wiki-entity-hero--wide wiki-entity-hero--relic">
    <img class="wiki-image" src={relic.image} alt={title} loading="eager" decoding="async" fetchpriority="high" />
    <div class="wiki-entity-hero__details">
      <div class="entity-badges">
        {relic.rarity === 'Starter Relic' ? (
          <span class="tag" style={`--tag-color:${poolColor(relic.poolRaw)}`}>{ja?.rarity || relic.rarity}</span>
        ) : (
          <span class="tag tag--plain">{ja?.rarity || relic.rarity}</span>
        )}
      </div>
      <p class="game-description" lang="ja" set:html={descriptionHtml} />
      <dl class="entity-stats">
        <div><dt>プール</dt><dd>{ja?.pool || relic.pool}</dd></div>
        <div><dt>ショップ価格</dt><dd>{relic.price}</dd></div>
      </dl>

    {(ja?.flavor || relic.flavor) && (
      <>
        <h2 id="flavor">フレーバーテキスト</h2>
        <p>{ja?.flavor || relic.flavor}</p>
      </>
    )}

    {((ja?.notes || relic.notes).length > 0) && (
      <>
        <h2 id="notes">メモ</h2>
        <ul>
          {notesHtml.map((note) => <li set:html={note}></li>)}
        </ul>
      </>
    )}

    {related.length > 0 && (
      <>
        <h2 id="related">関連レリック</h2>
        <ul>
          {related.map((r) => <li><a href={`/jpn/docs/relics/${r.slug}/`}>{r.translations?.ja?.name || r.name}</a></li>)}
        </ul>
      </>
    )}
    </div>
  </div>

  <a class="return-link" href="/jpn/docs/relics/">レリック一覧に戻る</a>
</StarlightPage>
