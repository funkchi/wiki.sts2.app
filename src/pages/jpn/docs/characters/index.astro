---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { characters, accentFor } from '../../../../data/characters';
---

<StarlightPage lang="ja" frontmatter={{ title: 'キャラクター', description: 'Slay the Spire 2 の日本語キャラクター一覧。' }}>
  <p>
    キャラクターの日本語テキストはゲームファイルから逆コンパイルしています（<a href="https://github.com/ptrlrd/spire-codex">Spire Codex リポジトリ</a> に感謝）。
  </p>

  <div class="character-gallery">
    {characters.map((c) => (
      <a class="char-card" href={`/jpn/docs/characters/${c.slug}/`} style={`--char-accent:${accentFor(c.slug)}`}>
        <img class="char-card__icon" src={c.icon} alt={`${c.translations?.ja?.name || c.name} アイコン`} loading="lazy" decoding="async" />
        <div class="char-card__body">
          <strong>{c.translations?.ja?.name || c.name}</strong>
          <span class="char-card__stats">HP {c.startingHp ?? '-'} · エナジー {c.maxEnergy ?? '-'}</span>
        </div>
      </a>
    ))}
  </div>
</StarlightPage>
