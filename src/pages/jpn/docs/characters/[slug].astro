---
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CharacterHero from '../../../../components/CharacterHero.astro';
import { characters } from '../../../../data/characters';
import { cardBySlug } from '../../../../data/cards';
import { relicBySlug } from '../../../../data/relics';

export const getStaticPaths = (() => {
  return characters.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }));
}) satisfies GetStaticPaths;

const { character } = Astro.props;
const ja = character.translations?.ja;
const title = ja?.name || character.name;
const description = ja?.description || character.description || `${title} - Slay the Spire 2 キャラクター。`;
---

<StarlightPage frontmatter={{ title, description }}>
  <CharacterHero character={character} locale="jpn" />

  <h2 id="deck">初期デッキ</h2>
  <ul>
    {character.startingDeck.map((d) => {
      const card = cardBySlug.get(d.slug);
      return <li>{d.count > 1 ? `${d.count}x ` : ''}<a href={`/jpn/docs/cards/${d.slug}/`}>{card?.translations?.ja?.name || d.name}</a></li>;
    })}
  </ul>

  <h2 id="relics">初期レリック</h2>
  <ul>
    {character.startingRelics.map((r) => {
      const relic = relicBySlug.get(r.slug);
      return <li>{relic?.translations?.ja?.name || r.name}</li>;
    })}
  </ul>

  <p><a href="/jpn/docs/characters/">キャラクター一覧に戻る</a></p>
</StarlightPage>
