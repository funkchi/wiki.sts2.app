---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityBrowser from '../../../../components/EntityBrowser.svelte';
import { enemies } from '../../../../data/enemies';

const rows = enemies.map((e) => {
  const ja = e.translations?.ja;
  return {
    slug: e.slug,
    name: ja?.name || e.name,
    englishName: e.name,
    type: ja?.type || e.type,
    hp: e.hp,
    acts: e.acts,
    movesSummary: ja?.movesSummary || e.movesSummary,
  };
});
---

<StarlightPage frontmatter={{ title: '敵', description: 'Slay the Spire 2 の日本語敵一覧。' }}>
  <p>
    日本語訳は <a href="https://spire-codex.com/docs">Spire Codex API</a>{' '}
    <code>/api/exports/jpn</code> から取得しています。
  </p>
  <EntityBrowser
    client:idle
    entities={rows}
    linkBase="/jpn/docs/enemies/"
    noun="体の敵"
    nameLabel="敵"
    columns={[
      { field: 'englishName', label: '英語名', width: '16rem' },
      { field: 'type', label: 'タイプ' },
      { field: 'hp', label: 'HP' },
      { field: 'acts', label: '章' },
      { field: 'movesSummary', label: '行動' },
    ]}
    filters={[
      { field: 'type', label: 'タイプ' },
      { field: 'acts', label: '章', multiple: true },
    ]}
  />
</StarlightPage>
