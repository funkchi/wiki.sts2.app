---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { characters, accentFor } from '../../../../data/characters';
---

<StarlightPage frontmatter={{ title: '角色', description: '杀戮尖塔 2 中文角色资料。' }}>
  <p>
    角色中文翻译来自 <a href="https://spire-codex.com/docs">Spire Codex</a>{' '}
    <code>/api/exports/zhs</code> 导出。
  </p>

  <div class="character-gallery">
    {characters.map((c) => (
      <a class="char-card" href={`/zhs/docs/characters/${c.slug}/`} style={`--char-accent:${accentFor(c.slug)}`}>
        <img class="char-card__icon" src={c.icon} alt="" loading="lazy" decoding="async" />
        <div class="char-card__body">
          <strong>{c.translations?.zhHans?.name || c.name}</strong>
          <span class="char-card__stats">生命 {c.startingHp ?? '-'} · 能量 {c.maxEnergy ?? '-'}</span>
        </div>
      </a>
    ))}
  </div>
</StarlightPage>
