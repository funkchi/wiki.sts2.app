---
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CharacterHero from '../../../../components/CharacterHero.astro';
import { characters } from '../../../../data/characters';
import { cardBySlug } from '../../../../data/cards';
import { relicBySlug } from '../../../../data/relics';

export const getStaticPaths = (() => {
  return characters.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }));
}) satisfies GetStaticPaths;

const { character } = Astro.props;
const zh = character.translations?.zhHans;
const title = zh?.name || character.name;
const description = zh?.description || character.description || `${title} - 杀戮尖塔 2 角色。`;
---

<StarlightPage lang="zh-Hans" frontmatter={{ title, description }}>
  <CharacterHero character={character} locale="zhs" >
    <Fragment slot="aside">
    <h2 id="deck">初始卡组</h2>
    <ul>
      {character.startingDeck.map((d) => {
        const card = cardBySlug.get(d.slug);
        return <li>{d.count > 1 ? `${d.count}x ` : ''}<a href={`/zhs/docs/cards/${d.slug}/`}>{card?.translations?.zhHans?.name || d.name}</a></li>;
      })}
    </ul>

    <h2 id="relics">初始遗物</h2>
    <ul>
      {character.startingRelics.map((r) => {
        const relic = relicBySlug.get(r.slug);
        return <li>{relic?.translations?.zhHans?.name || r.name}</li>;
      })}
    </ul>
    </Fragment>
  </CharacterHero>

  <a class="return-link" href="/zhs/docs/characters/">返回全部角色</a>
</StarlightPage>
