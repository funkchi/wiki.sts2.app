---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityBrowser from '../../../../components/EntityBrowser.svelte';
import { enhancementIndexRows } from '../../../../data/enchantments';

const rows = enhancementIndexRows('zhs');
---

<StarlightPage frontmatter={{ title: '附魔', description: '杀戮尖塔 2 卡牌附魔资料。' }}>
  <p>
    附魔数据来自 <a href="https://spire-codex.com/docs">Spire Codex API</a>{' '}
    <code>/api/enchantments?lang=zhs</code>。
  </p>
  <EntityBrowser
    client:idle
    entities={rows}
    linkBase="/zhs/docs/enhancements/"
    noun="个附魔"
    nameLabel="附魔"
    columns={[
      { field: 'cardType', label: '卡牌类型', width: '10rem' },
      { field: 'applicableTo', label: '适用于', width: '16rem' },
      { field: 'stackable', label: '可叠加', width: '9rem' },
      { field: 'extraCardText', label: '额外卡牌文本', width: '30rem' },
    ]}
    filters={[
      { field: 'cardType', label: '卡牌类型' },
      { field: 'applicableTo', label: '适用于' },
      { field: 'stackable', label: '可叠加' },
    ]}
  />
</StarlightPage>
