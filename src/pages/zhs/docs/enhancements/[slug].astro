---
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EnhancementDetail from '../../../../components/EnhancementDetail.astro';
import { enchantmentForLocale, enchantments } from '../../../../data/enchantments';

export const getStaticPaths = (() =>
  enchantments.map((enhancement) => ({ params: { slug: enhancement.slug }, props: { enhancement } }))) satisfies GetStaticPaths;

const { enhancement } = Astro.props;
const localized = enchantmentForLocale(enhancement, 'zhs');
const description = localized.description || `${localized.name} - 杀戮尖塔 2 附魔。`;
---

<StarlightPage frontmatter={{ title: localized.name, description }}>
  <EnhancementDetail enhancement={enhancement} locale="zhs" />
</StarlightPage>
