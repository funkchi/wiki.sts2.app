---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityBrowser from '../../../../components/EntityBrowser.svelte';
import { enemies } from '../../../../data/enemies';

const rows = enemies.map((e) => {
  const zh = e.translations?.zhHans;
  return {
    slug: e.slug,
    name: zh?.name || e.name,
    type: zh?.type || e.type,
    hp: e.hp,
    acts: e.acts,
    movesSummary: zh?.movesSummary || e.movesSummary,
  };
});
---

<StarlightPage frontmatter={{ title: '敌人', description: '杀戮尖塔 2 中文敌人资料。' }}>
  <p>
    敌人中文翻译来自 <a href="https://spire-codex.com/docs">Spire Codex API</a>{' '}
    <code>/api/exports/zhs</code> 导出。
  </p>
  <EntityBrowser
    client:idle
    entities={rows}
    linkBase="/zhs/docs/enemies/"
    noun="个敌人"
    nameLabel="敌人"
    columns={[
      { field: 'type', label: '类型' },
      { field: 'hp', label: '生命' },
      { field: 'acts', label: '章节' },
      { field: 'movesSummary', label: '行动' },
    ]}
    filters={[
      { field: 'type', label: '类型' },
      { field: 'acts', label: '章节', multiple: true },
    ]}
  />
</StarlightPage>
