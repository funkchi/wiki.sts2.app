---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityBrowser from '../../../../components/EntityBrowser.svelte';
import LanguageToggle from '../../../../components/LanguageToggle.astro';
import { cards } from '../../../../data/cards';

const rows = cards.map((c) => {
  const zh = c.translations?.zhHans;
  return {
    slug: c.slug,
    name: zh?.name || c.name,
    englishName: c.name,
    character: c.character,
    cost: c.cost,
    costRaw: c.costRaw,
    type: zh?.type || c.type,
    rarity: zh?.rarity || c.rarity,
    keywords: zh?.keywords?.length ? zh.keywords : c.matchedKeywords,
  };
});
---

<StarlightPage frontmatter={{ title: '卡牌', description: '杀戮尖塔 2 中文卡牌资料。' }}>
  <LanguageToggle locale="zhs" />
  <p>
    本页中文翻译来自 <a href="https://spire-codex.com/docs">Spire Codex API</a>{' '}
    <code>/api/exports/zhs</code> 导出。
  </p>
  <EntityBrowser
    client:idle
    entities={rows}
    linkBase="/zhs/docs/cards/"
    noun="张卡牌"
    nameLabel="卡牌"
    columns={[
      { field: 'englishName', label: '英文', width: '16rem' },
      { field: 'character', label: '角色', width: '13rem' },
      { field: 'cost', label: '费用', format: 'cardCost', width: '7rem' },
      { field: 'type', label: '类型', width: '9rem' },
      { field: 'rarity', label: '稀有度', width: '10rem' },
      { field: 'keywords', label: '关键词', chips: true, width: '26rem' },
    ]}
    filters={[
      { field: 'character', label: '角色 / 卡池' },
      { field: 'type', label: '类型' },
      { field: 'rarity', label: '稀有度' },
      { field: 'keywords', label: '关键词', multiple: true },
    ]}
  />
</StarlightPage>
