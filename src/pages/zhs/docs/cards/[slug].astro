---
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CardHero from '../../../../components/CardHero.astro';
import LanguageToggle from '../../../../components/LanguageToggle.astro';
import { cards, cardBySlug } from '../../../../data/cards';

export const getStaticPaths = (() => {
  return cards.map((card) => ({
    params: { slug: card.slug },
    props: { card },
  }));
}) satisfies GetStaticPaths;

const { card } = Astro.props;
const zh = card.translations?.zhHans;
const title = zh?.name || card.name;
const relatedCards = card.related
  .map((slug) => cardBySlug.get(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
const description = zh?.description || card.description || `${title} - 杀戮尖塔 2 卡牌。`;
---

<StarlightPage frontmatter={{ title, description }}>
  <LanguageToggle locale="zhs" />
  <CardHero card={card} locale="zhs" />

  {zh?.keywords && zh.keywords.length > 0 && (
    <>
      <h2 id="keywords">关键词</h2>
      <p>{zh.keywords.map((k) => <code>{k}</code>)}</p>
    </>
  )}

  <h2 id="related">相关卡牌</h2>
  {relatedCards.length > 0 ? (
    <ul>
      {relatedCards.map((c) => (
        <li><a href={`/zhs/docs/cards/${c.slug}/`}>{c.translations?.zhHans?.name || c.name}</a></li>
      ))}
    </ul>
  ) : (
    <p>暂无相关卡牌。</p>
  )}

  <p><a href="/zhs/docs/cards/">返回全部卡牌</a></p>
</StarlightPage>
