---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import { cards } from '../../data/cards';
import { relics } from '../../data/relics';
import { enemies } from '../../data/enemies';
import { characters } from '../../data/characters';

const sections = [
  { label: 'Cards', href: '/docs/cards/', count: cards.length, blurb: 'Searchable card library with base and upgrade text.' },
  { label: 'Relics', href: '/docs/relics/', count: relics.length, blurb: 'Relic effects, pools, rarities, and shop prices.' },
  { label: 'Enemies', href: '/docs/enemies/', count: enemies.length, blurb: 'Enemies with HP, moves, intents, and encounters.' },
  { label: 'Characters', href: '/docs/characters/', count: characters.length, blurb: 'Playable characters, starter decks, and relics.' },
  { label: 'Guides', href: '/guides/', count: 4, blurb: 'Strategy guides for early choices, deckbuilding, archetypes, and boss prep.' },
];
---

<StarlightPage frontmatter={{ title: 'Wiki' }}>
  <LanguageToggle />
  <p>A community reference for Slay the Spire 2. Pick a category to start:</p>
  <div class="wiki-hub-grid">
    {sections.map((s) => (
      <a class="hub-card" href={s.href}>
        <strong>{s.label}</strong>
        <span class="hub-count">{s.count}</span>
        <span class="hub-blurb">{s.blurb}</span>
      </a>
    ))}
  </div>
</StarlightPage>
