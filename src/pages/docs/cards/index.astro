---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityBrowser from '../../../components/EntityBrowser.svelte';
import { cardIndexRows } from '../../../data/cardIndexRows';

const rows = cardIndexRows('en');
---

<StarlightPage frontmatter={{ title: 'Cards' }}>
  <p>
    All card data on this page is decompiled from the game files, thanks to the{' '}
    <a href="https://github.com/ptrlrd/spire-codex">Spire Codex repo</a>.
  </p>
  <EntityBrowser
    client:idle
    entities={rows}
    linkBase="/docs/cards/"
    noun="cards"
    nameLabel="Card"
    columns={[
      { field: 'character', label: 'Character', width: '13rem' },
      { field: 'cost', label: 'Cost', format: 'cardCost', width: '7rem' },
      { field: 'type', label: 'Type', width: '9rem' },
      { field: 'rarity', label: 'Rarity', badge: 'rarity', width: '10rem' },
      { field: 'keywords', label: 'Keywords', chips: true, width: '26rem' },
    ]}
    filters={[
      { field: 'character', label: 'Character / Pool' },
      { field: 'type', label: 'Type' },
      { field: 'rarity', label: 'Rarity' },
      { field: 'keywords', label: 'Keyword', multiple: true },
    ]}
  />
</StarlightPage>
