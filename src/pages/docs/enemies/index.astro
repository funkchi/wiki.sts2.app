---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityBrowser from '../../../components/EntityBrowser.svelte';
import { enemies } from '../../../data/enemies';

const rows = enemies.map((e) => ({
  slug: e.slug,
  name: e.name,
  type: e.type,
  hp: e.hp,
  acts: e.acts,
  movesSummary: e.movesSummary,
}));
---

<StarlightPage frontmatter={{ title: 'Enemies' }}>
  <p>
    Enemy data is decompiled from the game files, thanks to the{' '}
    <a href="https://github.com/ptrlrd/spire-codex">Spire Codex repo</a>.
  </p>
  <EntityBrowser
    client:idle
    entities={rows}
    linkBase="/docs/enemies/"
    noun="enemies"
    nameLabel="Enemy"
    columns={[
      { field: 'type', label: 'Type', badge: 'type' },
      { field: 'hp', label: 'HP' },
      { field: 'acts', label: 'Act' },
      { field: 'movesSummary', label: 'Moves' },
    ]}
    filters={[
      { field: 'type', label: 'Class' },
      { field: 'acts', label: 'Act', multiple: true },
    ]}
  />
</StarlightPage>
