---
interface CostRaw {
  cost: number | null;
  starCost: number | null;
  isX: boolean;
  isXStar: boolean;
}
interface Props {
  card: {
    name: string;
    image: string;
    imageUpg?: string | null;
    description: string;
    upgradeDescription: string;
    character: string;
    type: string;
    rarity: string;
    cost: string;
    costRaw: CostRaw;
    upgradeCost?: number | null;
    target: string;
    matchedKeywords: string[];
    translations?: Record<string, any>;
  };
  locale?: 'en' | 'zhs';
}
const { card, locale = 'en' } = Astro.props;
const c = card.costRaw;
const zh = locale === 'zhs' ? card.translations?.zhHans : undefined;
const display = {
  name: zh?.name || card.name,
  description: zh?.description || card.description,
  upgradeDescription: zh?.upgradeDescription || card.upgradeDescription,
  type: zh?.type || card.type,
  rarity: zh?.rarity || card.rarity,
  target: zh?.target || card.target,
  keywords: Array.isArray(zh?.keywords) ? zh.keywords : card.matchedKeywords,
};

const norm = (val: string) =>
  String(val).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const STAR = 'https://cdn.spire-codex.com/icons/star_icon.webp';

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
function highlight(text: string, terms: string[], cls: string): string {
  const safe = esc(text);
  if (!terms || terms.length === 0) return safe;
  const re = new RegExp('\\b(' + terms.map(escRe).join('|') + ')\\b', 'gi');
  return safe.replace(re, `<span class="${cls}">$1</span>`);
}
const descHtml = display.description
  ? highlight(display.description, display.keywords, 'kw')
  : 'No description is currently available.';
const upgHtml = display.upgradeDescription
  ? highlight(display.upgradeDescription, display.keywords, 'kw kw--muted')
  : '';

const rows: Array<[string, string]> = [
  [locale === 'zhs' ? '角色 / 卡池' : 'Character / Pool', card.character],
  [locale === 'zhs' ? '类型' : 'Type', display.type],
  [locale === 'zhs' ? '稀有度' : 'Rarity', display.rarity],
  [locale === 'zhs' ? '目标' : 'Target', display.target],
];
---

<div class="wiki-entity-hero">
  <div class="wiki-hero-art">
    <button
      class="wiki-image-toggle"
      type="button"
      data-base={card.image}
      data-upg={card.imageUpg ?? ''}
      data-state="base"
      aria-label="Toggle upgraded artwork"
    >
      <span class="wiki-image-stack">
        <img
          class="wiki-image wiki-image--card-detail wiki-image--base"
          src={card.image}
          alt={display.name}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {card.imageUpg && (
          <img
            class="wiki-image wiki-image--card-detail wiki-image--upgraded"
            src={card.imageUpg}
            alt={`${display.name} upgraded`}
            loading="eager"
            decoding="async"
            fetchpriority="low"
          />
        )}
      </span>
    </button>
    {card.imageUpg && <p class="wiki-image-hint">{locale === 'zhs' ? '点击图片查看升级版' : 'Click image to view upgrade'}</p>}
  </div>

  <div class="wiki-entity-hero__details">
    <div class="entity-badges">
      <span class={`tag tag--rarity-${norm(card.rarity)}`}>{display.rarity}</span>
    </div>

    <p set:html={descHtml} />
    {upgHtml && <p class="upgrade-text" set:html={upgHtml} />}

    <table>
      <tbody>
        {rows.map(([label, value]) => (
          <tr><th scope="row">{label}</th><td>{value}</td></tr>
        ))}
        <tr>
          <th scope="row">{locale === 'zhs' ? '费用' : 'Cost'}</th>
          <td>
            {c.cost === -1 || c.cost === -2
              ? 'Unplayable'
              : c.isXStar
                ? (<>X <img class="star-icon" src={STAR} alt="star" /></>)
                : c.isX
                  ? 'X'
                  : c.starCost !== null && c.starCost !== undefined
                    ? (<>{c.cost}/{c.starCost} <img class="star-icon" src={STAR} alt="star" /></>)
                    : String(c.cost)}
            {card.upgradeCost !== null && card.upgradeCost !== undefined && (
              <span class="cost-upgrade"> → {card.upgradeCost}</span>
            )}
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.querySelector('.wiki-image-toggle');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    var upg = btn.dataset.upg;
    if (!upg) return;
    btn.addEventListener('click', function () {
      var isUpg = btn.dataset.state === 'upg';
      btn.dataset.state = isUpg ? 'base' : 'upg';
      btn.classList.toggle('is-upgraded', !isUpg);
    });
  })();
</script>
