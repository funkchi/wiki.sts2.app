---
import { localizedCharacterLabel, translationKey, type Lang } from '../data/i18n';

interface CostRaw {
  cost: number | null;
  starCost: number | null;
  isX: boolean;
  isXStar: boolean;
}
interface Props {
  card: {
    name: string;
    image: string;
    imageUpg?: string | null;
    description: string;
    upgradeDescription: string;
    character: string;
    type: string;
    rarity: string;
    cost: string;
    costRaw: CostRaw;
    upgradeCost?: number | null;
    target: string;
    matchedKeywords: string[];
    translations?: Record<string, any>;
  };
  locale?: Lang;
}
const { card, locale = 'en' } = Astro.props;
const c = card.costRaw;
const translatedCard = translationKey(locale) ? card.translations?.[translationKey(locale)!] : undefined;
const display = {
  name: translatedCard?.name || card.name,
  description: translatedCard?.description || card.description,
  upgradeDescription: translatedCard?.upgradeDescription || card.upgradeDescription,
  type: translatedCard?.type || card.type,
  rarity: translatedCard?.rarity || card.rarity,
  target: translatedCard?.target || card.target,
  keywords: Array.isArray(translatedCard?.keywords) ? translatedCard.keywords : card.matchedKeywords,
};

const labels = {
  en: {
    pool: 'Character / Pool',
    type: 'Type',
    rarity: 'Rarity',
    target: 'Target',
    cost: 'Cost',
    unplayable: 'Unplayable',
    hint: 'Click image to view upgrade',
    upgradedAlt: 'upgraded',
  },
  zhs: {
    pool: '角色 / 卡池',
    type: '类型',
    rarity: '稀有度',
    target: '目标',
    cost: '费用',
    unplayable: '不可打出',
    hint: '点击图片查看升级版',
    upgradedAlt: '升级版',
  },
  jpn: {
    pool: 'キャラクター / プール',
    type: 'タイプ',
    rarity: 'レアリティ',
    target: '対象',
    cost: 'コスト',
    unplayable: 'プレイ不可',
    hint: '画像をクリックしてアップグレード版を表示',
    upgradedAlt: 'アップグレード版',
  },
}[locale];

const norm = (val: string) =>
  String(val).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const STAR = 'https://cdn.spire-codex.com/icons/star_icon.webp';

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
function highlight(text: string, terms: string[], cls: string): string {
  const safe = esc(text);
  if (!terms || terms.length === 0) return safe;
  const re = new RegExp('\\b(' + terms.map(escRe).join('|') + ')\\b', 'gi');
  return safe.replace(re, `<span class="${cls}">$1</span>`);
}
const descHtml = display.description
  ? highlight(display.description, display.keywords, 'kw')
  : 'No description is currently available.';
const upgHtml = display.upgradeDescription
  ? highlight(display.upgradeDescription, display.keywords, 'kw kw--muted')
  : '';

const rows: Array<[string, string]> = [
  [labels.pool, localizedCharacterLabel(locale, card.character)],
  [labels.type, display.type],
  [labels.rarity, display.rarity],
  [labels.target, display.target],
];
---

<div class="wiki-entity-hero">
  <div class="wiki-hero-art">
    <button
      class="wiki-image-toggle"
      type="button"
      data-base={card.image}
      data-upg={card.imageUpg ?? ''}
      data-state="base"
      aria-label="Toggle upgraded artwork"
    >
      <span class="wiki-image-stack">
        <img
          class="wiki-image wiki-image--card-detail wiki-image--base"
          src={card.image}
          alt={display.name}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {card.imageUpg && (
          <img
            class="wiki-image wiki-image--card-detail wiki-image--upgraded"
            src={card.imageUpg}
            alt={`${display.name} ${labels.upgradedAlt}`}
            loading="eager"
            decoding="async"
            fetchpriority="low"
          />
        )}
      </span>
    </button>
    {card.imageUpg && <p class="wiki-image-hint">{labels.hint}</p>}
  </div>

  <div class="wiki-entity-hero__details">
    <div class="entity-badges">
      <span class={`tag tag--rarity-${norm(card.rarity)}`}>{display.rarity}</span>
    </div>

    <p set:html={descHtml} />
    {upgHtml && <p class="upgrade-text" set:html={upgHtml} />}

    <table>
      <tbody>
        {rows.map(([label, value]) => (
          <tr><th scope="row">{label}</th><td>{value}</td></tr>
        ))}
        <tr>
          <th scope="row">{labels.cost}</th>
          <td>
            {c.isXStar
                ? (<>X <img class="star-icon" src={STAR} alt="star" /></>)
                : c.isX
                  ? 'X'
                  : c.cost === -1 || c.cost === -2
                    ? labels.unplayable
                    : c.starCost !== null && c.starCost !== undefined
                      ? (<>{c.cost}/{c.starCost} <img class="star-icon" src={STAR} alt="star" /></>)
                      : String(c.cost)}
            {card.upgradeCost !== null && card.upgradeCost !== undefined && (
              <span class="cost-upgrade"> → {card.upgradeCost}</span>
            )}
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.querySelector('.wiki-image-toggle');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    var upg = btn.dataset.upg;
    if (!upg) return;
    btn.addEventListener('click', function () {
      var isUpg = btn.dataset.state === 'upg';
      btn.dataset.state = isUpg ? 'base' : 'upg';
      btn.classList.toggle('is-upgraded', !isUpg);
    });
  })();
</script>
