---
import { cards } from '../data/cards';
import { events } from '../data/events';
import { enchantments } from '../data/enchantments';
import Analytics from './Analytics.astro';
import LanguageToggle from './LanguageToggle.astro';
import snapshot from '../../data/spire-codex-snapshot.json';
import { languages, localizedPath, siteTitleFor, type Lang } from '../data/i18n';

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const SITE = 'https://wiki.sts2.app';
const sc = snapshot.collections;
const counts = {
  cards: cards.length,
  relics: sc.relics.length,
  enemies: sc.monsters.length,
  characters: sc.characters.length,
  events: events.length,
  enhancements: enchantments.length,
  communityGuides: sc.guides.length,
};
const originalGuides = 4;
const ogImage = `${SITE}/images/hero.png`;

const copy = {
  en: {
    lang: 'en',
    title: 'Slay the Spire 2 Wiki',
    description:
      'A fast community wiki for Slay the Spire 2 cards, relics, characters, enemies, and guides.',
    ogDesc: 'Cards, relics, characters, enemies, and strategy for Slay the Spire 2.',
    navLabel: 'Primary',
    legalLabel: 'Legal',
    nav: [
      { label: 'Cards', href: '/docs/cards/' },
      { label: 'Characters', href: '/docs/characters/' },
      { label: 'Relics', href: '/docs/relics/' },
      { label: 'Events', href: '/docs/events/' },
      { label: 'Enhancements', href: '/docs/enhancements/' },
      { label: 'Guides', href: '/guides/' },
    ],
    kicker: 'Community reference',
    subtitle: `${counts.cards} cards, ${counts.relics} relics, ${counts.enemies} enemies, ${counts.events} events, characters, and strategy notes for faster run planning.`,
    primary: 'Browse cards',
    secondary: 'Open wiki',
    primaryHref: '/docs/cards/',
    secondaryHref: '/docs/',
    exploreKicker: 'Explore',
    exploreTitle: 'Jump straight to the run data.',
    exploreText: 'Built for quick lookup at campfires, shops, draft picks, and boss prep.',
    cards: [
      {
        href: '/docs/characters/',
        eyebrow: 'Roster',
        title: 'Characters',
        text: 'Playable characters, starter kits, and defining mechanics.',
      },
      {
        href: '/docs/cards/',
        eyebrow: 'Library',
        title: 'Cards',
        text: `${counts.cards} searchable cards with base and upgrade text.`,
      },
      {
        href: '/docs/relics/',
        eyebrow: 'Power',
        title: 'Relics',
        text: `${counts.relics} relic effects, pools, and price ranges.`,
      },
      {
        href: '/docs/enemies/',
        eyebrow: 'Threats',
        title: 'Enemies',
        text: `${counts.enemies} enemies with encounters, moves, and patterns.`,
      },
      {
        href: '/docs/events/',
        eyebrow: 'Choices',
        title: 'Events',
        text: `${counts.events} events with requirements, rewards, and branching results.`,
      },
      {
        href: '/docs/enhancements/',
        eyebrow: 'Modifiers',
        title: 'Enhancements',
        text: `${counts.enhancements} card enhancements with restrictions and extra text.`,
      },
      {
        href: '/guides/',
        eyebrow: 'Strategy',
        title: 'Guides',
        text: `${originalGuides} original strategy guides plus ${counts.communityGuides} curated community guides.`,
      },
    ],
    source:
      'Game data is sourced from the <a href="https://spire-codex.com/docs">Spire Codex API</a>. The wiki is structured to expand as more Early Access details become reliable.',
    disclaimer: 'Community project. Not affiliated with Mega Crit.',
    footerLinks: [
      { label: 'About', href: '/about/' },
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Disclaimer', href: '/disclaimer/' },
    ],
  },
  zhs: {
    lang: 'zh-Hans',
    title: '杀戮尖塔 2 Wiki',
    description: '快速查找《杀戮尖塔 2》的卡牌、遗物、角色、敌人和攻略资料。',
    ogDesc: '《杀戮尖塔 2》的卡牌、遗物、角色、敌人和策略资料。',
    navLabel: '主导航',
    legalLabel: '站点链接',
    nav: [
      { label: '卡牌', href: '/zhs/docs/cards/' },
      { label: '角色', href: '/zhs/docs/characters/' },
      { label: '遗物', href: '/zhs/docs/relics/' },
      { label: '敌人', href: '/zhs/docs/enemies/' },
      { label: '事件', href: '/zhs/docs/events/' },
      { label: '附魔', href: '/zhs/docs/enhancements/' },
    ],
    kicker: '社区资料库',
    subtitle: `${counts.cards} 张卡牌、${counts.relics} 件遗物、${counts.enemies} 个敌人、${counts.events} 个事件，以及角色资料，帮助你更快规划路线。`,
    primary: '浏览卡牌',
    secondary: '进入资料库',
    primaryHref: '/zhs/docs/cards/',
    secondaryHref: '/zhs/docs/',
    exploreKicker: '探索',
    exploreTitle: '直接查看跑图所需数据。',
    exploreText: '适合在营火、商店、选牌和 Boss 准备时快速查询。',
    cards: [
      {
        href: '/zhs/docs/characters/',
        eyebrow: '角色',
        title: '角色',
        text: '可玩角色、初始套牌、初始遗物和核心机制。',
      },
      {
        href: '/zhs/docs/cards/',
        eyebrow: '卡牌库',
        title: '卡牌',
        text: `${counts.cards} 张可搜索卡牌，包含基础文本和升级文本。`,
      },
      {
        href: '/zhs/docs/relics/',
        eyebrow: '遗物',
        title: '遗物',
        text: `${counts.relics} 件遗物的效果、归属、稀有度和价格范围。`,
      },
      {
        href: '/zhs/docs/enemies/',
        eyebrow: '敌人',
        title: '敌人',
        text: `${counts.enemies} 个敌人的遭遇、行动和规律。`,
      },
      {
        href: '/zhs/docs/events/',
        eyebrow: '选项',
        title: '事件',
        text: `${counts.events} 个事件的条件、奖励与分支结果。`,
      },
      {
        href: '/zhs/docs/enhancements/',
        eyebrow: '附魔',
        title: '附魔',
        text: `${counts.enhancements} 个卡牌附魔，包含限制与额外卡牌文本。`,
      },
    ],
    source:
      '游戏数据来自 <a href="https://spire-codex.com/docs">Spire Codex API</a>。随着抢先体验信息更加可靠，资料库会继续扩展。',
    disclaimer: '社区项目，与 Mega Crit 无关联。',
    footerLinks: [
      { label: '卡牌', href: '/zhs/docs/cards/' },
      { label: '遗物', href: '/zhs/docs/relics/' },
      { label: '敌人', href: '/zhs/docs/enemies/' },
      { label: '角色', href: '/zhs/docs/characters/' },
      { label: '事件', href: '/zhs/docs/events/' },
      { label: '附魔', href: '/zhs/docs/enhancements/' },
    ],
  },
  jpn: {
    lang: 'ja',
    title: 'Slay the Spire 2 日本語Wiki',
    description: 'Slay the Spire 2 のカード、レリック、キャラクター、敵を素早く調べられる日本語Wiki。',
    ogDesc: 'Slay the Spire 2 のカード、レリック、キャラクター、敵、攻略情報。',
    navLabel: 'メインナビゲーション',
    legalLabel: 'サイトリンク',
    nav: [
      { label: 'カード', href: '/jpn/docs/cards/' },
      { label: 'キャラクター', href: '/jpn/docs/characters/' },
      { label: 'レリック', href: '/jpn/docs/relics/' },
      { label: '敵', href: '/jpn/docs/enemies/' },
      { label: 'イベント', href: '/jpn/docs/events/' },
      { label: 'エンチャント', href: '/jpn/docs/enhancements/' },
    ],
    kicker: 'コミュニティ資料',
    subtitle: `${counts.cards} 枚のカード、${counts.relics} 個のレリック、${counts.enemies} 体の敵、${counts.events} 件のイベント、キャラクター情報を素早く確認できます。`,
    primary: 'カードを見る',
    secondary: 'Wikiを開く',
    primaryHref: '/jpn/docs/cards/',
    secondaryHref: '/jpn/docs/',
    exploreKicker: '探索',
    exploreTitle: 'ランに必要なデータへすぐ移動。',
    exploreText: '焚き火、ショップ、カード選択、ボス準備での素早い確認に向いています。',
    cards: [
      {
        href: '/jpn/docs/characters/',
        eyebrow: 'ロスター',
        title: 'キャラクター',
        text: 'プレイアブルキャラクター、初期デッキ、初期レリック、主要メカニクス。',
      },
      {
        href: '/jpn/docs/cards/',
        eyebrow: 'ライブラリ',
        title: 'カード',
        text: `${counts.cards} 枚の検索可能なカード。基本テキストとアップグレード後テキストを掲載。`,
      },
      {
        href: '/jpn/docs/relics/',
        eyebrow: 'パワー',
        title: 'レリック',
        text: `${counts.relics} 個のレリック効果、プール、レアリティ、価格帯。`,
      },
      {
        href: '/jpn/docs/enemies/',
        eyebrow: '脅威',
        title: '敵',
        text: `${counts.enemies} 体の敵の遭遇、行動、パターン。`,
      },
      {
        href: '/jpn/docs/events/',
        eyebrow: '選択肢',
        title: 'イベント',
        text: `${counts.events} 件のイベントの条件、報酬、分岐結果。`,
      },
      {
        href: '/jpn/docs/enhancements/',
        eyebrow: 'エンチャント',
        title: 'エンチャント',
        text: `${counts.enhancements} 件のカードエンチャント、制限、追加テキスト。`,
      },
    ],
    source:
      'ゲームデータは <a href="https://spire-codex.com/docs">Spire Codex API</a> から取得しています。早期アクセス情報の信頼性が高まり次第、Wikiも拡張します。',
    disclaimer: 'コミュニティプロジェクトです。Mega Crit とは関係ありません。',
    footerLinks: [
      { label: 'カード', href: '/jpn/docs/cards/' },
      { label: 'レリック', href: '/jpn/docs/relics/' },
      { label: '敵', href: '/jpn/docs/enemies/' },
      { label: 'キャラクター', href: '/jpn/docs/characters/' },
      { label: 'イベント', href: '/jpn/docs/events/' },
      { label: 'エンチャント', href: '/jpn/docs/enhancements/' },
    ],
  },
} satisfies Record<Lang, any>;

const text = copy[locale];
const canonicalPath = localizedPath('/', locale);
const canonical = `${SITE}${canonicalPath}`;
const alternateUrls = languages.map((language) => ({
  language,
  href: `${SITE}${localizedPath('/', language.code)}`,
}));
const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: text.title,
      description: text.description,
      inLanguage: text.lang,
    },
    {
      '@type': 'VideoGame',
      name: 'Slay the Spire 2',
      description: text.ogDesc,
      genre: ['Roguelike', 'Deckbuilder', 'Strategy'],
      applicationCategory: 'Game',
      url: canonical,
      image: ogImage,
      inLanguage: text.lang,
    },
  ],
});
---

<!doctype html>
<html lang={text.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{text.title}</title>
    <meta name="description" content={text.description} />
    <link rel="canonical" href={canonical} />
    {alternateUrls.map(({ language, href }) => <link rel="alternate" hreflang={language.hreflang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#100c16" />
    <meta name="google-adsense-account" content="ca-pub-8661972209515901" />
    <meta property="og:title" content={text.title} />
    <meta property="og:description" content={text.ogDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitleFor(locale)} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={text.title} />
    <meta name="twitter:description" content={text.ogDesc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={ldJson} />
    <link
      rel="preload"
      as="image"
      href="/images/hero-1280.avif"
      imagesrcset="/images/hero-1280.avif 1280w, /images/hero-1920.avif 1920w"
      imagesizes="100vw"
      fetchpriority="high"
    />
    <script is:inline src="/docs/javascripts/consent.js"></script>
    <Analytics />
    <script is:inline defer src="/docs/javascripts/wiki-analytics.js"></script>
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8661972209515901"
      crossorigin="anonymous"></script>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :root {
        color-scheme: dark;
        --bg: #100c16;
        --panel: rgba(255, 246, 234, 0.08);
        --panel-strong: rgba(255, 246, 234, 0.14);
        --text: #fff6ea;
        --muted: rgba(255, 246, 234, 0.72);
        --line: rgba(255, 246, 234, 0.17);
        --gold: #f0a24a;
        --gold-ink: #201207;
        --violet: #a98aff;
        --sl-color-text: var(--text);
        --sl-color-text-accent: #ffd08b;
        --sl-color-gray-5: var(--line);
        --sl-color-bg-nav: rgba(16, 12, 22, 0.92);
        --sl-color-accent-low: rgba(240, 162, 74, 0.16);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-width: 320px;
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        letter-spacing: 0;
      }

      a {
        color: inherit;
      }

      .site-shell {
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgba(16, 12, 22, 0.08), #100c16 76%),
          image-set(
              url('/images/hero-1280.avif') type('image/avif') 1x,
              url('/images/hero-1920.avif') type('image/avif') 2x,
              url('/images/hero-1280.webp') type('image/webp') 1x,
              url('/images/hero-1920.webp') type('image/webp') 2x,
              url('/images/hero.png') type('image/png') 2x
            )
            center top / min(2200px, 160vw) auto no-repeat;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        min-height: 64px;
        padding: 0.75rem clamp(1rem, 4vw, 3rem);
        border-bottom: 1px solid rgba(255, 246, 234, 0.08);
        background: rgba(16, 12, 22, 0.78);
        backdrop-filter: blur(16px);
      }

      .brand {
        font-weight: 850;
        letter-spacing: 0;
        text-decoration: none;
        white-space: nowrap;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      .nav a {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        padding: 0 0.75rem;
        border-radius: 6px;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 650;
        text-decoration: none;
      }

      .nav a:hover {
        background: var(--panel);
        color: var(--text);
      }

      .language-toggle {
        position: relative;
        display: inline-block;
        color: var(--text);
        font-size: 0.82rem;
        font-weight: 800;
      }

      .language-toggle summary {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.65rem 0.35rem 0.45rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(16, 12, 22, 0.72);
        color: var(--text);
        cursor: pointer;
        list-style: none;
      }

      .language-toggle summary::-webkit-details-marker {
        display: none;
      }

      .language-toggle summary:hover,
      .language-toggle summary:focus-visible {
        color: #ffd08b;
        border-color: rgba(240, 162, 74, 0.62);
        outline: none;
      }

      .language-toggle summary img {
        width: 1.35rem;
        height: 1.35rem;
        object-fit: contain;
        filter: invert(1);
      }

      .language-toggle__menu {
        position: absolute;
        right: 0;
        top: calc(100% + 0.45rem);
        z-index: 30;
        min-width: 10rem;
        padding: 0.35rem;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(16, 12, 22, 0.94);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
      }

      .language-toggle__menu a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.45rem 0.55rem;
        border-radius: 6px;
        color: var(--text);
        text-decoration: none;
      }

      .language-toggle__menu a:hover,
      .language-toggle__menu a:focus-visible,
      .language-toggle__menu a[aria-current='page'] {
        background: rgba(240, 162, 74, 0.16);
        color: #ffd08b;
        outline: none;
      }

      .language-toggle__menu small {
        opacity: 0.75;
      }

      .hero {
        min-height: calc(100vh - 150px);
        display: grid;
        align-items: end;
        padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 3rem);
      }

      .hero__content {
        width: min(760px, 100%);
        padding-top: clamp(5rem, 12vh, 7.5rem);
      }

      .kicker {
        display: inline-flex;
        padding: 0.38rem 0.65rem;
        border: 1px solid rgba(240, 162, 74, 0.45);
        border-radius: 999px;
        background: rgba(240, 162, 74, 0.1);
        color: #ffd08b;
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 720px;
        margin: 1rem 0 0;
        font-size: clamp(3rem, 8vw, 5.7rem);
        line-height: 0.95;
        letter-spacing: 0;
        text-wrap: balance;
        text-shadow: 0 8px 40px rgba(0, 0, 0, 0.45);
      }

      .subtitle {
        max-width: 590px;
        margin: 1.2rem 0 0;
        color: var(--muted);
        font-size: clamp(1rem, 2vw, 1.22rem);
        line-height: 1.65;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.7rem;
      }

      .button {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel);
        color: var(--text);
        font-weight: 780;
        text-decoration: none;
        transition:
          transform 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .button:hover {
        transform: translateY(-1px);
        border-color: rgba(255, 246, 234, 0.34);
        background: var(--panel-strong);
      }

      .button--primary {
        border-color: #f0a24a;
        background: var(--gold);
        color: var(--gold-ink);
      }

      .button--primary:hover {
        background: #ffb45f;
      }

      .content-band {
        padding: 0 clamp(1rem, 4vw, 3rem) 4rem;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        width: min(1120px, 100%);
        margin: 0 auto 1rem;
      }

      h2 {
        margin: 0;
        font-size: clamp(1.55rem, 3vw, 2.25rem);
        line-height: 1.1;
        letter-spacing: 0;
      }

      .section-head p {
        max-width: 430px;
        margin: 0;
        color: var(--muted);
        line-height: 1.55;
      }

      .wiki-grid {
        width: min(1120px, 100%);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 0.85rem;
        margin: 0 auto;
      }

      .wiki-card {
        min-height: 158px;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        padding: 1rem;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: linear-gradient(180deg, var(--panel-strong), var(--panel));
        text-decoration: none;
      }

      .wiki-card:hover {
        border-color: rgba(240, 162, 74, 0.62);
        background: rgba(255, 246, 234, 0.13);
      }

      .wiki-card small {
        color: var(--gold);
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .wiki-card strong {
        font-size: 1.08rem;
      }

      .wiki-card span {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.45;
      }

      .status {
        width: min(1120px, 100%);
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: 0.85rem;
        margin: 0.85rem auto 0;
      }

      .status__panel {
        padding: 1rem;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255, 246, 234, 0.06);
      }

      .status__panel p {
        margin: 0;
        color: var(--muted);
        line-height: 1.55;
      }

      .status__panel a {
        color: #ffd08b;
        font-weight: 760;
        text-decoration: none;
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
        padding: 2rem clamp(1rem, 4vw, 3rem);
        border-top: 1px solid rgba(255, 246, 234, 0.08);
        color: rgba(255, 246, 234, 0.48);
        font-size: 0.86rem;
      }

      footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      footer a {
        color: rgba(255, 246, 234, 0.72);
        text-decoration: none;
      }

      @media (max-width: 900px) {
        .section-head,
        .status {
          display: block;
        }

        .section-head p {
          margin-top: 0.6rem;
        }

        .status__panel + .status__panel {
          margin-top: 0.85rem;
        }
      }

      @media (max-width: 620px) {
        .site-shell {
          background-size: auto 540px;
          background-position: center top;
        }

        .topbar {
          position: static;
          align-items: flex-start;
          flex-direction: column;
        }

        .nav {
          width: 100%;
          overflow-x: auto;
          padding-bottom: 0.15rem;
        }

        .nav a {
          flex: 0 0 auto;
        }

        .hero {
          min-height: 560px;
          align-items: end;
        }

        .hero__content {
          padding-top: 220px;
        }

        .actions,
        .button {
          width: 100%;
        }

        .wiki-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={canonicalPath}>{text.title}</a>
        <nav class="nav" aria-label={text.navLabel}>
          {text.nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <LanguageToggle locale={locale} pathname={canonicalPath} autoDetect={true} />
        </nav>
      </header>

      <main>
        <section class="hero">
          <div class="hero__content">
            <span class="kicker">{text.kicker}</span>
            <h1>{text.title}</h1>
            <p class="subtitle">{text.subtitle}</p>
            <div class="actions">
              <a class="button button--primary" href={text.primaryHref}>{text.primary}</a>
              <a class="button" href={text.secondaryHref}>{text.secondary}</a>
            </div>
          </div>
        </section>

        <section class="content-band" aria-labelledby="explore-title">
          <div class="section-head">
            <div>
              <span class="kicker">{text.exploreKicker}</span>
              <h2 id="explore-title">{text.exploreTitle}</h2>
            </div>
            <p>{text.exploreText}</p>
          </div>

          <div class="wiki-grid">
            {text.cards.map((card) => (
              <a class="wiki-card" href={card.href}>
                <small>{card.eyebrow}</small>
                <strong>{card.title}</strong>
                <span>{card.text}</span>
              </a>
            ))}
          </div>

          <div class="status">
            <div class="status__panel">
              <p set:html={text.source} />
            </div>
            <div class="status__panel">
              <p>{text.disclaimer}</p>
            </div>
          </div>
        </section>
      </main>
    </div>

    <footer>
      <span>{text.title}</span>
      <nav aria-label={text.legalLabel}>
        {text.footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </footer>
  </body>
</html>
