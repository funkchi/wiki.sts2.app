---
import Analytics from './Analytics.astro';
import { languages, localizedPath } from '../data/i18n';
import { cardBySlug } from '../data/cards';
import { relicBySlug } from '../data/relics';
import { enemyBySlug } from '../data/enemies';
import { characterBySlug } from '../data/characters';

const SITE = 'https://wiki.sts2.app';
const DEFAULT_OG = `${SITE}/images/hero.png`;
const { head } = Astro.locals.starlightRoute as any;
const pathname = Astro.url.pathname;

type Kind = 'cards' | 'relics' | 'enemies' | 'characters';
function resolveEntity(path: string): { kind: Kind; name: string; image?: string } | null {
  const p = path.replace(/^\/(?:zhs|jpn)/, '');
  const m = p.match(/^\/docs\/(cards|relics|enemies|characters)\/([^/]+)\/?$/);
  if (!m) return null;
  const kind = m[1] as Kind;
  const map = { cards: cardBySlug, relics: relicBySlug, enemies: enemyBySlug, characters: characterBySlug }[kind];
  const item: any = map.get(m[2]);
  return item ? { kind, name: item.name, image: item.image } : null;
}

const entity = resolveEntity(pathname);
const ogImage = entity?.image
  ? entity.image.startsWith('http') ? entity.image : `${SITE}${entity.image}`
  : DEFAULT_OG;

// Drop Starlight's own twitter:card so we can force summary_large_image with an image.
const filteredHead = head.filter((h: any) => h.attrs?.name !== 'twitter:card');

const base = Astro.site ?? new URL(SITE);
const alternateUrls = languages.map((language) => ({
  language,
  url: new URL(localizedPath(pathname, language.code), base),
}));
const isLocalizedPath =
  pathname.startsWith('/docs/') ||
  pathname === '/docs/' ||
  pathname.startsWith('/zhs/') ||
  pathname.startsWith('/jpn/');

function breadcrumbJson(): string | null {
  if (!entity) return null;
  const label: Record<Kind, string> = { cards: 'Cards', relics: 'Relics', enemies: 'Enemies', characters: 'Characters' };
  return JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Wiki', item: `${SITE}/docs/` },
      { '@type': 'ListItem', position: 2, name: label[entity.kind], item: `${SITE}/docs/${entity.kind}/` },
      { '@type': 'ListItem', position: 3, name: entity.name, item: `${SITE}${pathname}` },
    ],
  });
}
const ldJson = breadcrumbJson();
---

{filteredHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{isLocalizedPath && (
  <>
    {alternateUrls.map(({ language, url }) => (
      <link rel="alternate" hreflang={language.hreflang} href={url.toString()} />
    ))}
  </>
)}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#100c16" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Slay the Spire 2 Wiki" />
{ldJson && <script type="application/ld+json" set:html={ldJson} />}
<Analytics />
