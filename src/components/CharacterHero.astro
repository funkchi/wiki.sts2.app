---
import { accentFor } from '../data/characters';
import type { Character } from '../data/characters';

interface Props {
  character: Character;
  locale?: 'en' | 'zhs';
}
const { character, locale = 'en' } = Astro.props;
const accent = accentFor(character.slug);
const c = character;
const zh = locale === 'zhs' ? c.translations?.zhHans : undefined;

const stats: Array<[string, string | number | null]> = [
  [locale === 'zhs' ? '初始生命' : 'Starting HP', c.startingHp],
  [locale === 'zhs' ? '初始金币' : 'Starting Gold', c.startingGold],
  [locale === 'zhs' ? '能量' : 'Energy', c.maxEnergy],
  [locale === 'zhs' ? '充能球栏位' : 'Orb Slots', c.orbSlots],
  [locale === 'zhs' ? '解锁条件' : 'Unlocks After', zh?.unlocksAfter || c.unlocksAfter],
];
const shown = stats.filter(([, v]) => v !== null && v !== '-' && v !== '');
---

<div class="character-hero" style={`--char-accent:${accent}`}>
  <img class="character-hero__art" src={c.image} alt={zh?.name || c.name} loading="eager" decoding="async" fetchpriority="high" />
  <div class="character-hero__body">
    <div class="character-hero__head">
      <img class="character-hero__icon" src={c.icon} alt="" loading="lazy" decoding="async" />
      <div>
        <p class="kicker-char">{zh?.character || c.character}</p>
        <h2>{zh?.name || c.name}</h2>
      </div>
    </div>
    <p class="character-hero__desc">{zh?.description || c.description || 'No description is currently available.'}</p>
    <div class="stat-badges">
      {shown.map(([label, value]) => (
        <span class="stat-badge"><strong>{value}</strong> {label}</span>
      ))}
    </div>
  </div>
</div>
